# Shared settings — copy to .env. Anything that differs between the local and
# hosted databases belongs in a per-target file instead (see .env.local.example
# and .env.aura.example); those are applied after this one and win on conflicts.

# Optional, increases openFDA rate limits during ingest.
OPENFDA_API_KEY=

# API only. Comma-separated exact origins allowed to call the API.
# Read at import, so a value here does apply locally. Railway sets its own.
# Production example: https://med-graph.vercel.app
MED_GRAPH_CORS_ORIGINS=http://localhost:5173

# API only, optional. Regex for origins that change per deploy, such as
# Vercel previews: https://med-graph-.*\.vercel\.app
MED_GRAPH_CORS_ORIGIN_REGEX=
