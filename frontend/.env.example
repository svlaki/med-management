# Base URL of the FastAPI backend, no trailing slash.
#
# Leave unset for local development: Vite proxies /api to localhost:8000, so a
# locally run backend needs no configuration at all.
#
# To point a local frontend at the deployed Railway backend instead, put this
# in frontend/.env.local (gitignored) and restart `npm run dev`:
#   VITE_API_BASE_URL=https://med-graph-api-production.up.railway.app
# That is a cross-origin call, so Railway's MED_GRAPH_CORS_ORIGINS must also
# list http://localhost:5173.
#
# Vercel sets this to the Railway public URL in its own project settings.
VITE_API_BASE_URL=
