# Large regenerable pipeline intermediates. Rebuild with:
#   scripts/export_rxnorm_classes.py, scripts/export_openfda_labels.py,
#   scripts/export_faers.py, scripts/build_drug_dataset.py,
#   scripts/merge_pharmacology.py (last: joins the psych pharmacology columns in)
# Remove these two lines if you'd rather version them (~14MB) or use Git LFS.
data_clean/drug_master.csv
data_clean/faers_raw.csv

# spreadsheet copies of the CSVs in this directory
data_clean/*.xlsx

# Secrets: covers .env plus per-target files like .env.local and .env.aura.
# Templates stay tracked.
.env.*
!**/.env.example
!**/.env.*.example

# Claude Code worktrees are nested git repos; never commit them.
.claude/worktrees/
