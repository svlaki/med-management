# Copy to .env.aura — the hosted Neo4j Aura instance the deployed API reads.
# Select it with --env aura or MED_GRAPH_ENV=aura. Destructive scripts prompt
# before writing here because the URI is not a loopback address.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
